# ================================
# Professional Cross-Platform .gitignore
# ================================
# Last updated: $(date)
# Covers: Windows, macOS, Linux, Python, Node.js, IDEs, Editors, and more
# ================================

# ----- Local Environment & Secrets -----
# Never commit secrets or local configurations
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local
.env.staging.local
*.env
*.local
*.secrets
*.key
*.key.*
*.pem
*.p12
*.pfx
*.cert
*.crt
*.secret
*.lock
secrets/
keys/
config/secrets/
.vault/
credentials/
passwords/

# Password files
*.pass
*.password
passwd

# SSH keys
*.pub
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pem

# GPG keys
*.gpg
*.pgp
*.asc

# ----- Python -----
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

