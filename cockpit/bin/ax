#!/usr/bin/env bash
# AXIOM shell command definition; intended to be sourced.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "This file must be sourced from ~/.zshrc.local via the AXIOM overlay."
  exit 1
fi

_ax_repo_root() {
  if [[ -n "${AXIOM_REPO_ROOT:-}" && -d "${AXIOM_REPO_ROOT}" ]]; then
    printf '%s\n' "${AXIOM_REPO_ROOT}"
    return 0
  fi
  local source_dir
  source_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
  if [[ -d "${source_dir}/../.." ]]; then
    (cd -P "${source_dir}/../.." >/dev/null 2>&1 && pwd -P)
    return 0
  fi
  return 1
}

_ax_version_value() {
  local repo_root
  repo_root="$(_ax_repo_root 2>/dev/null || true)"

  if [[ -n "${AXIOM_VERSION:-}" ]]; then
    printf '%s\n' "${AXIOM_VERSION}"
    return 0
  fi

  if [[ -n "$repo_root" && -f "${repo_root}/VERSION" ]]; then
    tr -d '[:space:]' <"${repo_root}/VERSION"
    return 0
  fi

  printf '%s\n' "unknown"
}

_ax_blux_version() {
  local version_file="${BLUX10K_INSTALL_DIR:-$HOME/.blux10k}/VERSION"
  if [[ -f "$version_file" ]]; then
    tr -d '[:space:]' <"$version_file"
  else
    printf '%s\n' "missing"
  fi
}

_ax_bluxgpt_repo_root() {
  if [[ -n "${BLUXGPT_REPO_ROOT:-}" && -d "${BLUXGPT_REPO_ROOT}" ]]; then
    printf '%s\n' "${BLUXGPT_REPO_ROOT}"
    return 0
  fi
  printf '%s\n' ""
}

_ax_bluxgpt_cli_path() {
  local root
  root="$(_ax_bluxgpt_repo_root)"
  if [[ -n "$root" ]]; then
    printf '%s\n' "${root}/bluxgpt/cli.py"
    return 0
  fi
  printf '%s\n' ""
}

_ax_bluxgpt_available() {
  local cli_path
  cli_path="$(_ax_bluxgpt_cli_path)"
  if [[ "${BLUXGPT_READY:-0}" == "1" && -n "${BLUXGPT_REPO_ROOT:-}" && -f "${cli_path}" ]]; then
    printf '%s\n' "1"
  else
    printf '%s\n' "0"
  fi
}

_ax_bluxgpt_overlay_present() {
  local zlocal="$HOME/.zshrc.local"
  if [[ -f "$zlocal" ]] && grep -qE 'BLUXGPT|bluxgpt|blux' "$zlocal"; then
    printf '%s\n' "1"
  else
    printf '%s\n' "0"
  fi
}

_ax_help() {
  cat <<'HELP'
ax <command>

Commands:
  help        Show this help
  version     Print AXIOM, blux10k, and BluxGPT versions
  launch      Run AXIOM launch.sh
  status      Show AXIOM command and overlay status
  doctor      Validate AXIOM + blux10k prereqs
  locker      Run locker tools shell
  armory      Run armory shell
  ai          Proxy to blux when BLUXGPT_READY=1
  uninstall   Remove AXIOM overlay and installed ax command
HELP
}

_ax_launch() {
  local repo_root
  repo_root="$(_ax_repo_root)" || {
    echo "AXIOM repo root not found."
    return 1
  }

  if [[ ! -x "${repo_root}/launch.sh" ]]; then
    echo "launch.sh not found or not executable at ${repo_root}/launch.sh"
    return 1
  fi

  "${repo_root}/launch.sh"
}

_ax_status() {
  local repo_root
  repo_root="$(_ax_repo_root 2>/dev/null || true)"
  local ax_path="$HOME/tools/scripts/axiom/ax"
  local zlocal="$HOME/.zshrc.local"
  local blux10k_scripts="${BLUX10K_INSTALL_DIR:-$HOME/.blux10k}/tools/scripts"
  local locker_path=""
  local armory_path=""
  if [[ -n "$repo_root" ]]; then
    locker_path="${repo_root}/locker"
    armory_path="${repo_root}/armory"
  fi

  echo "AXIOM status (trifecta runtime)"
  echo "blux10k: ready=${BLUX10K_READY:-0} version=$(_ax_blux_version) scripts=${blux10k_scripts}"
  echo "AXIOM: ready=${AXIOM_READY:-0} version=$(_ax_version_value) repo=${repo_root:-unset}"
  echo "AXIOM: ax=$(command -v ax 2>/dev/null || echo unavailable) installed_ax=${ax_path} locker=${locker_path:-unset} armory=${armory_path:-unset}"
  if [[ -f "$zlocal" ]] && grep -q '### >>> AXIOM OVERLAY >>>' "$zlocal"; then
    echo "AXIOM overlay: present"
  else
    echo "AXIOM overlay: missing"
  fi
  echo "BluxGPT: ready=${BLUXGPT_READY:-0} version=${BLUXGPT_VERSION:-missing} backend_available=$(_ax_bluxgpt_available)"
}

_ax_doctor() {
  local failed=0
  local repo_root
  repo_root="$(_ax_repo_root 2>/dev/null || true)"
  local ax_path="$HOME/tools/scripts/axiom/ax"
  local zlocal="$HOME/.zshrc.local"
  local blux10k_scripts="${BLUX10K_INSTALL_DIR:-$HOME/.blux10k}/tools/scripts"
  local bluxgpt_cli
  bluxgpt_cli="$(_ax_bluxgpt_cli_path)"

  echo "=== AXIOM Doctor: Trifecta Runtime Report ==="
  echo ""
  echo "[blux10k layer]"
  echo "BLUX10K_READY=${BLUX10K_READY:-0}"
  echo "BLUX10K_VERSION=$(_ax_blux_version)"
  echo "BLUX10K_SCRIPTS_PATH=${blux10k_scripts}"
  if [[ -d "${blux10k_scripts}" ]]; then
    echo "[ok] blux10k scripts path exists"
  else
    echo "[warn] blux10k scripts path missing"
    failed=1
  fi
  echo ""

  echo "[AXIOM layer]"
  echo "AXIOM_READY=${AXIOM_READY:-0}"
  echo "AXIOM_VERSION=$(_ax_version_value)"
  echo "AXIOM_REPO_ROOT=${repo_root:-unset}"
  echo "INSTALLED_AX_PATH=${ax_path}"
  if [[ -n "$repo_root" ]]; then
    echo "LOCKER_PATH=${repo_root}/locker"
    echo "ARMORY_PATH=${repo_root}/armory"
  else
    echo "LOCKER_PATH=unset"
    echo "ARMORY_PATH=unset"
  fi
  if command -v ax >/dev/null 2>&1; then
    echo "[ok] ax command available at $(command -v ax)"
  else
    echo "[warn] ax command not in PATH"
    failed=1
  fi
  if [[ -f "$ax_path" ]]; then
    echo "[ok] installed ax path present"
  else
    echo "[warn] installed ax path missing"
    failed=1
  fi

  if [[ -f "$zlocal" ]] && grep -q '### >>> AXIOM OVERLAY >>>' "$zlocal"; then
    echo "[ok] overlay block present"
  else
    echo "[warn] overlay block missing from ~/.zshrc.local"
    failed=1
  fi
  if [[ -n "$repo_root" && -d "${repo_root}/locker" ]]; then
    echo "[ok] locker path present"
  else
    echo "[warn] locker path missing"
    failed=1
  fi
  if [[ -n "$repo_root" && -d "${repo_root}/armory" ]]; then
    echo "[ok] armory path present"
  else
    echo "[warn] armory path missing"
    failed=1
  fi
  echo ""

  echo "[BluxGPT layer]"
  echo "BLUXGPT_READY=${BLUXGPT_READY:-0}"
  echo "BLUXGPT_VERSION=${BLUXGPT_VERSION:-missing}"
  echo "BLUXGPT_REPO_ROOT=${BLUXGPT_REPO_ROOT:-unset}"
  echo "BLUXGPT_CLI_PATH=${bluxgpt_cli:-unset}"
  if command -v blux >/dev/null 2>&1; then
    echo "[ok] blux command available at $(command -v blux)"
  else
    echo "[warn] blux command unavailable"
  fi
  if [[ "$(_ax_bluxgpt_overlay_present)" == "1" ]]; then
    echo "[ok] BluxGPT overlay markers appear present in ~/.zshrc.local"
  else
    echo "[warn] BluxGPT overlay markers not detected in ~/.zshrc.local"
  fi
  if [[ "$(_ax_bluxgpt_available)" == "1" ]]; then
    echo "[ok] BluxGPT backend available (ready + repo + cli.py)"
  else
    echo "[warn] BluxGPT backend unavailable; gpt-4o-mini fallback will be used by Overwatch AI"
  fi
  if [[ -n "${OPENAI_API_KEY:-}" && -n "${OPENAI_MODEL:-}" ]]; then
    echo "[ok] fallback OPENAI_API_KEY and OPENAI_MODEL appear set in environment"
  else
    echo "[warn] fallback OPENAI_API_KEY and/or OPENAI_MODEL missing in environment"
  fi

  if [[ -d "$HOME/.config/axiom" ]]; then
    echo "[ok] config directory present"
  else
    echo "[warn] missing $HOME/.config/axiom"
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi
}

_ax_locker() {
  local repo_root
  repo_root="$(_ax_repo_root)" || {
    echo "AXIOM repo root not found."
    return 1
  }

  if [[ -x "${repo_root}/locker/warpdrive.sh" ]]; then
    "${repo_root}/locker/warpdrive.sh"
  else
    echo "Locker entrypoint not found: ${repo_root}/locker/warpdrive.sh"
    return 1
  fi
}

_ax_armory() {
  local repo_root
  repo_root="$(_ax_repo_root)" || {
    echo "AXIOM repo root not found."
    return 1
  }

  if [[ -x "${repo_root}/armory/armory.sh" ]]; then
    "${repo_root}/armory/armory.sh"
  else
    echo "Armory entrypoint not found: ${repo_root}/armory/armory.sh"
    return 1
  fi
}

_ax_ai() {
  if [[ "$(_ax_bluxgpt_available)" != "1" ]]; then
    echo "BluxGPT is not available (requires BLUXGPT_READY=1 + BLUXGPT_REPO_ROOT + bluxgpt/cli.py)."
    return 1
  fi

  if ! command -v blux >/dev/null 2>&1; then
    echo "BLUXGPT_READY=1 but 'blux' command is unavailable in PATH."
    return 1
  fi

  blux "$@"
}

_ax_uninstall() {
  local zlocal="$HOME/.zshrc.local"
  local ax_path="$HOME/tools/scripts/axiom/ax"
  local temp_file

  if [[ -f "$zlocal" ]]; then
    temp_file="$(mktemp)"
    awk '
      $0 == "### >>> AXIOM OVERLAY >>>" { skip=1; next }
      $0 == "### <<< AXIOM OVERLAY <<<" { skip=0; next }
      skip != 1 { print }
    ' "$zlocal" >"$temp_file"
    mv "$temp_file" "$zlocal"
    echo "Removed AXIOM overlay from $zlocal"
  fi

  if [[ -f "$ax_path" ]]; then
    rm -f "$ax_path"
    echo "Removed $ax_path"
  fi
}

ax() {
  local cmd="${1:-help}"
  case "$cmd" in
    help|-h|--help)
      _ax_help
      ;;
    version)
      echo "AXIOM: $(_ax_version_value)"
      echo "blux10k: $(_ax_blux_version)"
      echo "BluxGPT: ${BLUXGPT_VERSION:-missing}"
      ;;
    launch)
      shift
      _ax_launch "$@"
      ;;
    status)
      _ax_status
      ;;
    doctor)
      _ax_doctor
      ;;
    locker)
      shift
      _ax_locker "$@"
      ;;
    armory)
      shift
      _ax_armory "$@"
      ;;
    ai)
      shift
      _ax_ai "$@"
      ;;
    uninstall)
      _ax_uninstall
      ;;
    *)
      echo "Unknown ax command: $cmd"
      _ax_help
      return 1
      ;;
  esac
}
