# AXIOM v1.0 environment configuration example.
# Copy this file to cockpit/config/.env (or your deployment-specific env file)
# and set values appropriate for your environment.

# Minimum supported BLUX10K version for AXIOM compatibility checks.
BLUX10K_MIN_VERSION=2.0.0

# Official BLUX10K repository used for install/update workflows.
BLUX10K_REPO_URL=https://github.com/Outer-Void/blux10k.git

# Optional explicit BLUX10K installation path.
# Leave empty to allow installer/runtime defaults.
BLUX10K_INSTALL_DIR=

# Set to 1 for non-interactive automation, 0 for interactive behavior.
AXIOM_NONINTERACTIVE=0

# Set to 1 to preview actions without making changes.
AXIOM_DRY_RUN=0

# Linux account used for BLUX runtime ownership and process execution.
BLUX_USER=blux

# Set to 1 to install optional BLUX extras when supported.
BLUX_INSTALL_EXTRAS=1

# Node.js provisioning method for BLUX install flows.
BLUX_NODE_METHOD=nodesource

# Set to 1 only when passwordless sudo is intentionally configured.
BLUX_SUDO_PASSWORDLESS=0

# OpenAI API key used for remote model access.
# Required for OpenAI-backed flows. Do not commit real secrets.
OPENAI_API_KEY=

# Default OpenAI model identifier for AXIOM operations.
OPENAI_MODEL=gpt-4o-mini

# Base URL for the OpenAI-compatible API endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# HTTP timeout (seconds) for OpenAI API requests.
OPENAI_TIMEOUT=60

# Maximum response token budget requested from model calls.
OPENAI_MAX_OUTPUT_TOKENS=500
